@model GestorAtividades.Models.Atividade

@{
    ViewData["Title"] = "Editar atividade";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow-lg p-4">
                <h3 class="text-center mb-4">Editar atividade</h3>
                
                <form method="post" asp-action="UpdateAtividade" asp-controller="Pages" asp-route-id="@Model.Id"> 
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label class="form-label" asp-for="Titulo"> Título</label>
                        <input asp-for="Titulo" class="form-control" placeholder="Digite o título da atividade"/>
                        <span asp-validation-for="Titulo" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Status" class="form-label">Status</label>
                        <select asp-for="Status"
                                class="form-select"
                                asp-items="Html.GetEnumSelectList<StatusAtividade>()">
                        </select>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>


                    <div class="mb-3"> 
                        <label asp-for="DataInicio" class="form-label">Data prevista p/ início </label>
                        <input asp-for="DataInicio" class="form-control" type="datetime-local"/>
                        <span asp-validation-for="DataInicio" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DataConclusao" class="form-label">Data prevista p/ conclusão</label>
                        <input asp-for="DataConclusao" class="form-control" type="datetime-local"/>
                        <span asp-validation-for="DataConclusao" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Descricao" class="form-label">Descrição</label>
                        <div id="editor" style="height: 200px;"></div>
                        <input type="hidden" asp-for="Descricao" id="Descricao" />
                        <span asp-validation-for="Descricao" class="text-danger"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button class="btn btn-primary" type="submit">  Editar atividade</button>
                    </div>

                </form>

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger mt-3">
                        @TempData["ErrorMessage"]
                    </div>
                }
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<script>
    var quill = new Quill('#editor', {
        theme: 'snow',
        placeholder: 'Descreva sua atividade...',
        modules: {
            toolbar: [
                [{ 'header': [1, 2, false] }],
                ['bold', 'italic', 'underline'],
                [{ 'list': 'ordered' }, { 'list': 'bullet' }],
                ['link'],
                ['clean']
            ]
        }
    });

    // 🔥 CARREGAR DESCRIÇÃO EXISTENTE
    // Json.Serialize gera uma string JS escapada: aspas, crases e </script> na descrição não quebram o script.
    var descricaoExistente = @Json.Serialize(DescricaoSanitizer.Sanitizar(Model.Descricao));
    quill.root.innerHTML = descricaoExistente;

    // 🔥 AO SUBMETER, SALVAR O HTML
    document.querySelector('form').addEventListener('submit', function () {
        document.getElementById('Descricao').value = quill.root.innerHTML;
    });
</script>
