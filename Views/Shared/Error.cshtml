@model ErrorViewModel
@{
    ViewData["Title"] = Model.Titulo;
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <p class="display-4 fw-bold text-muted mb-0">@Model.Codigo</p>
        <h1 class="h3 mb-3">@Model.Titulo</h1>
        <p class="text-muted">@Model.Mensagem</p>

        <a class="btn btn-primary mt-2" asp-controller="Home" asp-action="Index">Voltar ao início</a>

        @if (Model.ShowRequestId && Model.Codigo >= 500)
        {
            <p class="small text-muted mt-4 mb-0">Código para suporte: <code>@Model.RequestId</code></p>
        }
    </div>
</div>
