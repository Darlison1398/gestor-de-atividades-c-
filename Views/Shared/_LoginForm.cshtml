@{
    var returnUrl = (string?)ViewBag.ReturnUrl ?? Context.Request.Query["returnUrl"].ToString();
}

<form method="post" asp-action="Login" asp-controller="Auth">
    <input type="hidden" name="returnUrl" value="@returnUrl" />

    <div class="mb-3">
        <label class="form-label">Email</label>
        <input class="form-control" type="email" name="email" required />
    </div>

    <div class="mb-3">
        <label class="form-label">Senha</label>
        <input class="form-control" type="password" name="senha" required />
    </div>

    <button class="btn btn-primary w-100" type="submit">Entrar</button>

    <div class="text-center mt-3">
        <a href="#" onclick="showForgot()">Esqueceu sua senha?</a>
    </div>

    <div class="text-center mt-2">
        <a href="#" onclick="showRegister()">Ainda não tem conta? Criar conta</a>
    </div>

    @if (ViewBag.Error != null)
    {
        <p class="text-danger text-center mt-2">@ViewBag.Error</p>
    }
</form>