@model AtividadeViewModel

@{
    ViewData["Title"] = Model.Titulo;
}

<nav aria-label="Trilha de navegação" class="mb-3">
    <ol class="breadcrumb small mb-0">
        <li class="breadcrumb-item"><a asp-action="Index">Minhas atividades</a></li>
        <li class="breadcrumb-item active text-truncate" aria-current="page">@Model.Titulo</li>
    </ol>
</nav>

<div class="row g-4">
    <div class="col-lg-8">
        <article class="card card-app h-100">
            <div class="card-body p-4">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                    <h1 class="h3 fw-bold mb-0">@Model.Titulo</h1>
                    <span class="@Model.Status.GetColor() rounded-pill fs-6">@Model.Status.GetDisplayName()</span>
                </div>

                <span class="prazo @Model.Prazo.Classe">
                    <i class="@Model.Prazo.Icone" aria-hidden="true"></i>@Model.Prazo.Texto
                </span>

                <h2 class="h6 text-body-secondary text-uppercase small fw-semibold mt-4">Descrição</h2>
                <div class="descricao">
                    @Html.Raw(Model.DescricaoHtml)
                </div>
            </div>
        </article>
    </div>

    <div class="col-lg-4">
        <aside class="card card-app">
            <div class="card-body p-4">
                <dl class="lista-info mb-0">
                    <dt>Data de início</dt>
                    <dd><i class="fa-regular fa-calendar me-2 text-body-secondary" aria-hidden="true"></i>@Model.DataInicio.ToString("dd/MM/yyyy")</dd>

                    <dt>Conclusão prevista</dt>
                    <dd><i class="fa-regular fa-calendar-check me-2 text-body-secondary" aria-hidden="true"></i>@Model.DataConclusao.ToString("dd/MM/yyyy")</dd>

                    <dt>Registrada em</dt>
                    <dd class="mb-0"><i class="fa-regular fa-calendar-plus me-2 text-body-secondary" aria-hidden="true"></i>@Model.DataRegistro.ToString("dd/MM/yyyy")</dd>
                </dl>
            </div>
            <div class="card-footer bg-transparent d-grid gap-2 p-3">
                <a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-primary">
                    <i class="fa-solid fa-pen me-1" aria-hidden="true"></i>Editar
                </a>
                <button type="button" class="btn btn-outline-danger"
                        data-bs-toggle="modal" data-bs-target="#confirmar-exclusao"
                        data-acao="@Url.Action("Excluir", new { id = Model.Id })" data-titulo="@Model.Titulo">
                    <i class="fa-solid fa-trash me-1" aria-hidden="true"></i>Excluir
                </button>
                <a asp-action="Index" class="btn btn-link">
                    <i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>Voltar para a lista
                </a>
            </div>
        </aside>
    </div>
</div>

<partial name="_ConfirmarExclusao" />
