@model RegistrarUsuarioViewModel

<form method="post" asp-action="Registrar" asp-controller="Auth">

    <div class="mb-3">
        <label asp-for="Nome" class="form-label"></label>
        <input asp-for="Nome" class="form-control" autocomplete="name" />
        <span asp-validation-for="Nome" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" type="email" autocomplete="email" />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <div class="mb-4">
        <label asp-for="Senha" class="form-label"></label>
        <input asp-for="Senha" class="form-control" autocomplete="new-password" aria-describedby="ajuda-senha" />
        <div id="ajuda-senha" class="form-text">Mínimo de 5 caracteres, com letra, número e símbolo.</div>
        <span asp-validation-for="Senha" class="text-danger small"></span>
    </div>

    <button class="btn btn-primary w-100" type="submit">Criar conta</button>
</form>
