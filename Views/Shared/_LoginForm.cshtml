@{
    var returnUrl = (string?)ViewBag.ReturnUrl ?? Context.Request.Query["returnUrl"].ToString();
}

<form method="post" asp-action="Login" asp-controller="Auth">
    <input type="hidden" name="ReturnUrl" value="@returnUrl" />

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger py-2" role="alert">
            <i class="fa-solid fa-circle-exclamation me-1" aria-hidden="true"></i>@ViewBag.Error
        </div>
    }

    <div class="mb-3">
        <label class="form-label" for="login-email">Email</label>
        <input class="form-control" id="login-email" type="email" name="Email" autocomplete="email" required />
    </div>

    <div class="mb-2">
        <label class="form-label" for="login-senha">Senha</label>
        <input class="form-control" id="login-senha" type="password" name="Senha" autocomplete="current-password" required />
    </div>

    <div class="text-end mb-4">
        <button type="button" class="btn btn-link btn-sm p-0" data-painel="forgot">Esqueceu sua senha?</button>
    </div>

    <button class="btn btn-primary w-100" type="submit">Entrar</button>
</form>
