<form method="post" asp-action="ForgotPassword" asp-controller="Auth">

    <div class="mb-3">
        <label class="form-label">Informe seu email</label>
        <input class="form-control" type="email" name="email" required />
    </div>

    <button class="btn btn-warning w-100" type="submit">
        Enviar link de recuperação
    </button>

    <div class="text-center mt-3">
        <a href="#" onclick="showLogin()">Voltar para o login</a>
    </div>

    @if (ViewBag.ForgotMessage != null)
    {
        <p class="text-success text-center mt-2">
            @ViewBag.ForgotMessage
        </p>
    }
</form>
