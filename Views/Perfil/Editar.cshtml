@model EditarPerfilViewModel

@{
    ViewData["Title"] = "Editar perfil";
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-xl-5">
        <nav aria-label="Trilha de navegação" class="mb-3">
            <ol class="breadcrumb small mb-0">
                <li class="breadcrumb-item"><a asp-action="Index">Meu perfil</a></li>
                <li class="breadcrumb-item active" aria-current="page">Editar</li>
            </ol>
        </nav>

        <div class="card card-app">
            <div class="card-body p-4 p-md-5">
                <h1 class="h4 fw-bold mb-4">Editar perfil</h1>

                <form method="post" asp-action="Editar">
                    <div class="mb-3">
                        <label asp-for="Nome" class="form-label fw-medium"></label>
                        <input asp-for="Nome" class="form-control" autocomplete="name" />
                        <span asp-validation-for="Nome" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label fw-medium"></label>
                        <input asp-for="Email" class="form-control" type="email" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <fieldset class="border-top pt-4 mb-4">
                        <legend class="h6 fw-semibold">Alterar senha</legend>
                        <p class="form-text mt-0 mb-3">Deixe em branco para manter a senha atual.</p>

                        <div class="mb-3">
                            <label asp-for="Senha" class="form-label fw-medium"></label>
                            <input asp-for="Senha" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="Senha" class="text-danger small"></span>
                        </div>

                        <div>
                            <label asp-for="ConfirmarSenha" class="form-label fw-medium"></label>
                            <input asp-for="ConfirmarSenha" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmarSenha" class="text-danger small"></span>
                        </div>
                    </fieldset>

                    <div class="d-flex flex-column-reverse flex-sm-row justify-content-end gap-2">
                        <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
                        <button class="btn btn-primary px-4" type="submit">
                            <i class="fa-solid fa-check me-1" aria-hidden="true"></i>Salvar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
