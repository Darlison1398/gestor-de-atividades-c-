@model GestorAtividades.Models.Usuario

@{
    ViewData["Title"] = "Perfil";
}

<div class="container mt-4">

    <div class="col-md-8 offset-md-2">

        <div class="card shadow-lg">
            <div class="card-body">
                <h3 class="card-title text-primary">@Model.Nome</h3>
                <hr />
                <p><strong>Email:</strong> @Model.Email</p>
                <p><strong>Ativo desde:</strong> @Model.DataRegistro.ToString("dd/MM/yyyy HH:mm")</p>
                <hr />
            </div>

            <div class="card-footer d-flex justify-content-between">
                <a href="@Url.Action("Main", "Pages")"
                   class="btn btn-outline-secondary">
                    Voltar
                </a>
                <a href="@Url.Action("EditarUsuario", "Auth")"
                   class="btn btn-outline-secondary">
                    Editar
                </a>
            </div>
        </div>
    </div>
</div>


