@{
    var logado = User.Identity?.IsAuthenticated == true;
    var controllerAtual = ViewContext.RouteData.Values["controller"]?.ToString();
    var actionAtual = ViewContext.RouteData.Values["action"]?.ToString();
    string Ativo(string controller, string? action = null) =>
        controllerAtual == controller && (action == null || actionAtual == action) ? "active" : "";
    string AriaAtual(string controller, string? action = null) =>
        Ativo(controller, action) == "active" ? "page" : "false";

    var nome = User.Identity?.Name ?? string.Empty;
    var partesNome = nome.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var iniciais = partesNome.Length switch
    {
        0 => "?",
        1 => partesNome[0][..1].ToUpperInvariant(),
        _ => (partesNome[0][..1] + partesNome[^1][..1]).ToUpperInvariant()
    };
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Crie e acompanhe suas atividades do dia a dia." />
    <title>@ViewData["Title"] · GestorAtividades</title>

    @* Aplica o tema salvo (ou o do sistema) antes de pintar a página, para não piscar. *@
    <script>
        (function () {
            var tema = localStorage.getItem('tema') ||
                (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-bs-theme', tema);
        })();
    </script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <a class="visually-hidden-focusable btn btn-primary position-absolute m-2" href="#conteudo">Pular para o conteúdo</a>

    <header>
        <nav class="navbar navbar-expand-md bg-body border-bottom sticky-top" aria-label="Navegação principal">
            <div class="container">
                <a class="navbar-brand fw-bold d-flex align-items-center gap-2"
                   asp-controller="@(logado ? "Atividades" : "Home")" asp-action="Index">
                    <span class="marca-icone" aria-hidden="true"><i class="fa-solid fa-list-check"></i></span>
                    GestorAtividades
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbar-principal"
                        aria-controls="navbar-principal" aria-expanded="false" aria-label="Abrir menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbar-principal">
                    <ul class="navbar-nav me-auto">
                        @if (logado)
                        {
                            <li class="nav-item">
                                <a class="nav-link @Ativo("Atividades", "Index")" aria-current="@AriaAtual("Atividades", "Index")"
                                   asp-controller="Atividades" asp-action="Index">Minhas atividades</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link @Ativo("Home", "Index")" aria-current="@AriaAtual("Home", "Index")"
                                   asp-controller="Home" asp-action="Index">Início</a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link @Ativo("Home", "Sobre")" aria-current="@AriaAtual("Home", "Sobre")"
                               asp-controller="Home" asp-action="Sobre">Sobre o projeto</a>
                        </li>
                    </ul>

                    <ul class="navbar-nav align-items-md-center gap-md-2">
                        <li class="nav-item">
                            <button type="button" class="btn nav-link" id="alternar-tema" aria-label="Alternar tema claro/escuro" title="Alternar tema">
                                <i class="fa-solid fa-moon" aria-hidden="true"></i>
                                <span class="d-md-none ms-2">Alternar tema</span>
                            </button>
                        </li>

                        @if (logado)
                        {
                            <li class="nav-item dropdown">
                                <button class="btn nav-link dropdown-toggle d-flex align-items-center gap-2" type="button"
                                        data-bs-toggle="dropdown" aria-expanded="false" aria-label="Menu da conta">
                                    <span class="avatar" aria-hidden="true">@iniciais</span>
                                    <span class="d-md-none d-lg-inline">@nome</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    <li><h6 class="dropdown-header text-truncate" style="max-width: 16rem;">@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</h6></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Atividades" asp-action="Criar">
                                            <i class="fa-solid fa-plus fa-fw me-2" aria-hidden="true"></i>Nova atividade
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Perfil" asp-action="Index">
                                            <i class="fa-solid fa-circle-user fa-fw me-2" aria-hidden="true"></i>Meu perfil
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form method="post" asp-controller="Auth" asp-action="Logout">
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="fa-solid fa-arrow-right-from-bracket fa-fw me-2" aria-hidden="true"></i>Sair
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else if (ViewData["OcultarEntrar"] as bool? != true)
                        {
                            @* A Home já mostra o formulário de login, então o botão some lá. *@
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm" asp-controller="Home" asp-action="Index">Entrar</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <partial name="_Messages" />

    <main id="conteudo" class="container py-4 py-md-5 flex-grow-1" tabindex="-1">
        @RenderBody()
    </main>

    <footer class="border-top py-3 bg-body">
        <div class="container d-flex flex-column flex-sm-row justify-content-between gap-2 small text-body-secondary">
            <span>&copy; @DateTime.Now.Year GestorAtividades</span>
            <span>
                <a class="link-secondary" asp-controller="Home" asp-action="Sobre">Sobre o projeto</a>
                <span aria-hidden="true">·</span>
                <a class="link-secondary" asp-controller="Home" asp-action="Autor">Sobre o autor</a>
            </span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
