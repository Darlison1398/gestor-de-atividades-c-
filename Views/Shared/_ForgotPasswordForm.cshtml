<form method="post" asp-action="EsqueciSenha" asp-controller="Auth">

    @if (ViewBag.ForgotMessage != null)
    {
        <div class="alert alert-success py-2" role="status">
            <i class="fa-solid fa-envelope-circle-check me-1" aria-hidden="true"></i>@ViewBag.ForgotMessage
        </div>
    }

    <div class="mb-4">
        <label class="form-label" for="recuperar-email">Email</label>
        <input class="form-control" id="recuperar-email" type="email" name="email" autocomplete="email" required />
    </div>

    <button class="btn btn-primary w-100" type="submit">Enviar link de recuperação</button>

    <div class="text-center mt-3">
        <button type="button" class="btn btn-link btn-sm" data-painel="login">
            <i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>Voltar para o login
        </button>
    </div>
</form>
