@{
    ViewData["Title"] = "Sobre o projeto";
}

<div class="container px-0">
    <section class="row align-items-center g-4 g-lg-5 mb-5" aria-labelledby="titulo-sobre">
        <div class="col-lg-7">
            <span class="badge rounded-pill text-bg-primary bg-opacity-10 text-primary-emphasis mb-3">
                <i class="fa-solid fa-list-check me-1" aria-hidden="true"></i> Um projeto de portfólio
            </span>
            <h1 id="titulo-sobre" class="display-5 fw-bold mb-3">Organização simples para tirar as tarefas do papel.</h1>
            <p class="lead text-body-secondary mb-4">
                O GestorAtividades é uma aplicação para planejar atividades, acompanhar prazos e visualizar cada etapa
                do trabalho em um só lugar.
            </p>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-primary" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-arrow-right-to-bracket me-2" aria-hidden="true"></i>Conhecer a aplicação
                </a>
                <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Autor">
                    Sobre quem desenvolveu
                </a>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card card-app h-100">
                <div class="card-body p-4 p-lg-5">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <span class="d-inline-flex align-items-center justify-content-center rounded-3 bg-primary text-white p-3" aria-hidden="true">
                            <i class="fa-solid fa-layer-group fa-lg"></i>
                        </span>
                        <div>
                            <h2 class="h5 fw-bold mb-1">Do início à conclusão</h2>
                            <p class="small text-body-secondary mb-0">Um fluxo claro para cada atividade.</p>
                        </div>
                    </div>
                    <ol class="list-unstyled mb-0">
                        <li class="d-flex gap-3 py-3 border-bottom">
                            <span class="badge rounded-pill text-bg-secondary align-self-start">1</span>
                            <span><strong>Planeje</strong><br /><span class="text-body-secondary small">Registre o título, a descrição e as datas.</span></span>
                        </li>
                        <li class="d-flex gap-3 py-3 border-bottom">
                            <span class="badge rounded-pill text-bg-primary align-self-start">2</span>
                            <span><strong>Acompanhe</strong><br /><span class="text-body-secondary small">Mova o cartão conforme o trabalho avança.</span></span>
                        </li>
                        <li class="d-flex gap-3 pt-3">
                            <span class="badge rounded-pill text-bg-success align-self-start">3</span>
                            <span><strong>Conclua</strong><br /><span class="text-body-secondary small">Veja o progresso e mantenha os prazos à vista.</span></span>
                        </li>
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <section class="mb-5" aria-labelledby="titulo-recursos">
        <div class="mb-4">
            <p class="small text-primary text-uppercase fw-semibold mb-1">O que você encontra</p>
            <h2 id="titulo-recursos" class="h3 fw-bold mb-0">Recursos para o dia a dia</h2>
        </div>
        <div class="row g-3">
            <div class="col-md-6 col-xl-3">
                <article class="card card-app h-100">
                    <div class="card-body p-4">
                        <span class="recurso-icone mb-3" aria-hidden="true"><i class="fa-solid fa-table-columns"></i></span>
                        <h3 class="h5 fw-semibold">Quadro e lista</h3>
                        <p class="text-body-secondary mb-0">Alterne entre o quadro por status e a lista com filtros para encontrar o que precisa.</p>
                    </div>
                </article>
            </div>
            <div class="col-md-6 col-xl-3">
                <article class="card card-app h-100">
                    <div class="card-body p-4">
                        <span class="recurso-icone mb-3" aria-hidden="true"><i class="fa-regular fa-calendar-check"></i></span>
                        <h3 class="h5 fw-semibold">Prazos visíveis</h3>
                        <p class="text-body-secondary mb-0">Identifique atividades atrasadas, com vencimento hoje ou próximas do prazo.</p>
                    </div>
                </article>
            </div>
            <div class="col-md-6 col-xl-3">
                <article class="card card-app h-100">
                    <div class="card-body p-4">
                        <span class="recurso-icone mb-3" aria-hidden="true"><i class="fa-solid fa-arrow-right-arrow-left"></i></span>
                        <h3 class="h5 fw-semibold">Etapas flexíveis</h3>
                        <p class="text-body-secondary mb-0">Atualize o andamento entre Pendente, Em Desenvolvimento, Em Teste e Concluído.</p>
                    </div>
                </article>
            </div>
            <div class="col-md-6 col-xl-3">
                <article class="card card-app h-100">
                    <div class="card-body p-4">
                        <span class="recurso-icone mb-3" aria-hidden="true"><i class="fa-solid fa-user-shield"></i></span>
                        <h3 class="h5 fw-semibold">Área por conta</h3>
                        <p class="text-body-secondary mb-0">Cada conta acessa e gerencia as próprias atividades.</p>
                    </div>
                </article>
            </div>
        </div>
    </section>

    <section class="card card-app" aria-labelledby="titulo-tecnologias">
        <div class="card-body p-4 p-md-5">
            <div class="row align-items-start g-4">
                <div class="col-lg-5">
                    <p class="small text-primary text-uppercase fw-semibold mb-1">Por trás da aplicação</p>
                    <h2 id="titulo-tecnologias" class="h3 fw-bold mb-2">Tecnologias utilizadas</h2>
                    <p class="text-body-secondary mb-0">O projeto reúne desenvolvimento web, persistência de dados e validação de formulários.</p>
                </div>
                <div class="col-lg-7">
                    <ul class="list-inline mb-0 d-flex flex-wrap gap-2" aria-label="Lista de tecnologias">
                        <li><span class="badge rounded-pill text-bg-secondary px-3 py-2">C#</span></li>
                        <li><span class="badge rounded-pill text-bg-secondary px-3 py-2">ASP.NET Core MVC</span></li>
                        <li><span class="badge rounded-pill text-bg-secondary px-3 py-2">Entity Framework Core</span></li>
                        <li><span class="badge rounded-pill text-bg-secondary px-3 py-2">PostgreSQL</span></li>
                        <li><span class="badge rounded-pill text-bg-secondary px-3 py-2">FluentValidation</span></li>
                        <li><span class="badge rounded-pill text-bg-secondary px-3 py-2">Bootstrap</span></li>
                        <li><span class="badge rounded-pill text-bg-secondary px-3 py-2">JavaScript</span></li>
                    </ul>
                    <p class="small text-body-secondary mt-4 mb-0">
                        Projeto de portfólio pessoal, desenvolvido em C# com ASP.NET Core MVC e hospedado em uma VPS na Hostinger.
                    </p>
                </div>
            </div>
        </div>
    </section>
</div>
