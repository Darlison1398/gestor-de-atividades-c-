@model AtividadeViewModel
@*
    Card de atividade usado no quadro e na lista.
    ViewData["MostrarStatus"] (bool): mostra o badge de status (na lista; no quadro a coluna já diz o status).
    ViewData["Arrastavel"] (bool): habilita arrastar entre colunas do quadro (wwwroot/js/atividades.js).
    ViewData["ReturnUrl"] (string): para onde o POST de "Mover para" volta quando não há JavaScript.
*@
@{
    var mostrarStatus = ViewData["MostrarStatus"] as bool? ?? false;
    var arrastavel = ViewData["Arrastavel"] as bool? ?? false;
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<article class="card card-app card-atividade @(Model.Status == StatusAtividade.Concluido ? "card-concluida" : "")"
         data-id="@Model.Id" data-status="@Model.Status" data-titulo="@Model.Titulo"
         @(arrastavel ? "draggable=true" : "") aria-labelledby="atividade-@Model.Id-titulo">
    <div class="card-body d-flex flex-column gap-2">

        <div class="d-flex justify-content-between align-items-center gap-2">
            <span class="prazo @Model.Prazo.Classe">
                <i class="@Model.Prazo.Icone" aria-hidden="true"></i>@Model.Prazo.Texto
            </span>

            <div class="acoes dropdown">
                <button type="button" class="btn btn-sm btn-acoes" data-bs-toggle="dropdown" aria-expanded="false"
                        data-bs-popper-config='{"strategy":"fixed"}' aria-label="Ações de @Model.Titulo">
                    <i class="fa-solid fa-ellipsis" aria-hidden="true"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                    <li><a class="dropdown-item" asp-action="Detalhes" asp-route-id="@Model.Id"><i class="fa-regular fa-eye fa-fw me-2" aria-hidden="true"></i>Ver detalhes</a></li>
                    <li><a class="dropdown-item" asp-action="Editar" asp-route-id="@Model.Id"><i class="fa-solid fa-pen fa-fw me-2" aria-hidden="true"></i>Editar</a></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li><h6 class="dropdown-header">Mover para</h6></li>
                    @foreach (var status in Enum.GetValues<StatusAtividade>().Where(s => s != Model.Status))
                    {
                        <li>
                            <form method="post" asp-action="AlterarStatus" asp-route-id="@Model.Id" data-mover>
                                <input type="hidden" name="status" value="@status" />
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                <button type="submit" class="dropdown-item">
                                    <span class="ponto-status ponto-@status.ToString().ToLowerInvariant()" aria-hidden="true"></span>@status.GetDisplayName()
                                </button>
                            </form>
                        </li>
                    }
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        <button type="button" class="dropdown-item text-danger"
                                data-bs-toggle="modal" data-bs-target="#confirmar-exclusao"
                                data-acao="@Url.Action("Excluir", new { id = Model.Id })" data-titulo="@Model.Titulo">
                            <i class="fa-solid fa-trash fa-fw me-2" aria-hidden="true"></i>Excluir
                        </button>
                    </li>
                </ul>
            </div>
        </div>

        <h3 class="h6 fw-semibold mb-0" id="atividade-@Model.Id-titulo">
            <a class="stretched-link link-body-emphasis text-decoration-none" asp-action="Detalhes" asp-route-id="@Model.Id" draggable="false">@Model.Titulo</a>
        </h3>

        @if (!string.IsNullOrEmpty(Model.Resumo))
        {
            <p class="resumo text-body-secondary small mb-0">@Model.Resumo</p>
        }

        <div class="mt-auto pt-1 d-flex justify-content-between align-items-center gap-2 small text-body-secondary">
            @if (mostrarStatus)
            {
                <span class="@Model.Status.GetColor() rounded-pill">@Model.Status.GetDisplayName()</span>
            }
            <span class="ms-auto datas" title="Início em @Model.DataInicio.ToString("dd/MM/yyyy") · conclusão prevista em @Model.DataConclusao.ToString("dd/MM/yyyy")">
                <i class="fa-regular fa-calendar me-1" aria-hidden="true"></i>@Model.DataInicio.ToString("dd/MM") – @Model.DataConclusao.ToString("dd/MM/yy")
            </span>
        </div>
    </div>
</article>
